[binaries]
c = '/usr/bin/loongarch64-linux-gnu-gcc'
cpp = '/usr/bin/loongarch64-linux-gnu-g++'
ar = '/usr/bin/loongarch64-linux-gnu-gcc-ar'
strip = '/usr/bin/loongarch64-linux-gnu-strip'
pkgconfig = 'pkg-config'

[host_machine]
system = 'linux'
cpu_family = 'loongarch64'
cpu = 'loongarch64'
endian = 'little'

